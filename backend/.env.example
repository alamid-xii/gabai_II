# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gabai_db
DB_USER=gabai_user
DB_PASSWORD=your_database_password_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_separate_random_session_secret
# Behind a trusted HTTPS reverse proxy only:
TRUST_PROXY=1

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Groq AI API (for AI Chatbot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Email Configuration (Nodemailer / OTP)
# For production inbox delivery, prefer a verified-domain SMTP provider (Brevo, Resend, Mailgun, Google Workspace)
# by setting SMTP_HOST/SMTP_PORT/SMTP_SECURE and using an HTTPS FRONTEND_URL (avoid http://localhost links).
EMAIL_SERVICE=gmail
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="GabAI - Eastern Mindoro College" <your_email@gmail.com>
EMAIL_REPLY_TO=emc_1945@yahoo.com
SCHOOL_CONTACT_EMAIL=emc_1945@yahoo.com

# ElevenLabs building narration (backend only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
